<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PDF+ 3 on Betta: the PDF+ engine (Engine\) with its 48 Grasshopper components written as attributed methods
    (Components\). Builds a plugin DLL for Rhino 8 + Betta 0.8: copy bin\<config>\net7.0-windows\*.dll into
    %AppData%\Grasshopper\Libraries\Betta\. The components keep the GUIDs of PDF+ 2.1, so its definitions open
    with this version; don't install the PDF+ 2.1 PdfPlus.gha next to it.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PdfPlus.Betta</AssemblyName>
    <RootNamespace>PdfPlus</RootNamespace>
    <Version>3.0.0</Version>
    <!-- nuget.org is added here so no nuget.config is needed. -->
    <RestoreSources>$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>
    <!-- PDFsharp 1.51 (the version the original references; its packages.config still says 1.50) and the MigraDoc extensions target .NET Framework; they run on .NET 7 (Windows, GDI). -->
    <NoWarn>$(NoWarn);NU1701;CS0168;CS0219;CS0414;CS0162</NoWarn>
    <!-- Put PDFsharp, MigraDoc and friends next to the DLL: the whole folder goes into Libraries\Betta. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The PDF+ icons, matched by IconResource = "<file name>". -->
    <EmbeddedResource Include="Icons\*.png" LogicalName="PdfPlus.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Betta.Abstractions" Version="0.8.0" ExcludeAssets="runtime" />
    <PackageReference Include="Betta.Preview" Version="0.8.0" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.3.24009.15001" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="8.3.24009.15001" ExcludeAssets="runtime" />
    <PackageReference Include="PDFsharp-MigraDoc-gdi" Version="1.51.5185-beta" />
    <PackageReference Include="MigraDoc.Extensions" Version="1.0.1" />
    <PackageReference Include="MigraDoc.Extensions.Html" Version="1.0.1" />
    <PackageReference Include="MigraDoc.Extensions.Markdown" Version="1.0.1" />
  </ItemGroup>

</Project>
